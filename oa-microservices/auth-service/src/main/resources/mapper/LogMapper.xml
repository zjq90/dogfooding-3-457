<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oa.auth.mapper.LogMapper">

    <resultMap id="BaseResultMap" type="com.oa.auth.entity.Log">
        <id column="id" property="id"/>
        <result column="employee_id" property="employeeId"/>
        <result column="operation_time" property="operationTime"/>
        <result column="operation" property="operation"/>
    </resultMap>

    <select id="selectByEmployeeId" resultMap="BaseResultMap">
        SELECT * FROM log WHERE employee_id = #{employeeId} ORDER BY operation_time DESC
    </select>

</mapper>
