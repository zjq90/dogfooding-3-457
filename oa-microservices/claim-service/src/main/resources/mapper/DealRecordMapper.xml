<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.oa.claim.mapper.DealRecordMapper">

    <resultMap id="BaseResultMap" type="com.oa.claim.entity.DealRecord">
        <id column="id" property="id"/>
        <result column="claim_voucher_id" property="claimVoucherId"/>
        <result column="deal_id" property="dealId"/>
        <result column="deal_time" property="dealTime"/>
        <result column="deal_type" property="dealType"/>
        <result column="deal_result" property="dealResult"/>
        <result column="comment" property="comment"/>
    </resultMap>

    <select id="selectByClaimVoucherId" resultMap="BaseResultMap">
        SELECT * FROM deal_record WHERE claim_voucher_id = #{claimVoucherId} ORDER BY deal_time ASC
    </select>

</mapper>
